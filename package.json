{
  "name": "ecs-starter-template",
  "version": "1.0.2",
  "description": "",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "start:dev": "cross-env NODE_ENV=development tsx src/server.ts",
    "start:prod": "cross-env NODE_ENV=production node dist/server.js",
    "clean:all": "rimraf dist coverage node_modules/.cache",
    "clean:build": "rimraf dist/**/*.map dist/**/*.tsbuildinfo",
    "build:fast": "rimraf dist && swc src -d dist",
    "build:prod": "npm run clean:all && swc src -d dist --env-name production",
    "debug": "tsx --inspect src/server.ts",
    "version:patch": "node scripts/bump-versions.cjs patch",
    "version:minor": "node scripts/bump-versions.cjs minor",
    "version:major": "node scripts/bump-versions.cjs major",
    "release": "npm run test && npm run version:patch && git add . && git commit -m \"chore: bump version\" && git push",
    "health": "node scripts/health-check.cjs",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register src/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1041.0",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/client-ssm": "^3.1041.0",
    "@fastify/circuit-breaker": "^4.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/otel": "^0.18.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/routes": "^6.0.2",
    "@fastify/routes-stats": "^4.0.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "fastify": "^5.8.5",
    "fastify-metrics": "^13.2.0",
    "inversify": "^8.1.0",
    "jose": "^6.2.3",
    "moment": "^2.30.1",
    "mysql2": "^3.22.3",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "winston": "^3.19.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.32",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  },
  "private": true
}
